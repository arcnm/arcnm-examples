{
  "$comment": "Every ARCNM operation the examples in this repo call, and the fields they send and read. .github/check_contract.py holds it against the live API every week; ARCNM checks it against every change before that change merges.",
  "operations": [
    {
      "method": "POST",
      "path": "/api/v1/calculations/upload-and-quote",
      "request": {
        "content_type": "multipart/form-data",
        "required": ["part_number", "cad_file"],
        "fields": ["costing_environment_id", "lot_size", "annual_volume", "drawing_file"]
      },
      "response": {"status": "202", "fields": ["id", "status"]}
    },
    {
      "method": "GET",
      "path": "/api/v1/calculations/{calculation_id}",
      "response": {
        "fields": [
          "id", "status", "currency", "unit_cost", "total_cost", "setup_cost",
          "unit_time_s", "total_time_s", "analytics", "coverage", "part_number"
        ]
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/calculations/{calculation_id}/cost-sheet",
      "query": ["quantity"],
      "response": {"fields": ["cost_sheet", "point"]}
    },
    {
      "method": "GET",
      "path": "/api/v1/environments/",
      "response": {"fields": ["id", "name"]}
    },
    {
      "method": "GET",
      "path": "/api/v1/pay/environments",
      "response": {"fields": ["default_environments", "environments"]}
    },
    {
      "method": "POST",
      "path": "/api/v1/pay/price",
      "request": {"content_type": "model/step"},
      "response": {
        "status": "402",
        "fields": ["offer_id", "units", "units_max", "environments", "price", "expires_at", "hint", "terms"]
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/pay/price",
      "response": {
        "status": "202",
        "fields": ["status", "purchase_id", "result_url", "result_token", "retry_after", "progress"]
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/pay/price",
      "response": {
        "status": "200",
        "fields": ["status", "purchase_id", "result_url", "result_token", "items", "receipt"]
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/pay/price/{purchase_id}",
      "response": {"status": "202", "fields": ["status", "result_url", "retry_after", "progress"]}
    },
    {
      "method": "GET",
      "path": "/api/v1/pay/price/{purchase_id}",
      "response": {"status": "200", "fields": ["status", "items", "receipt"]}
    }
  ]
}
